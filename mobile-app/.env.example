# Copy this file to .env and fill in the real values (never commit .env).
# Get these from the Supabase dashboard: Project Settings -> API.
# Use the "anon public" key ONLY — never the service_role key in this app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# DeepSeek API key, from https://platform.deepseek.com/api_keys.
# WARNING: EXPO_PUBLIC_ vars are compiled into the client JS bundle shipped to every
# device — this key is extractable by anyone who unpacks the built app. This was a
# deliberate tradeoff (direct-from-app call, no backend proxy) made to skip standing up
# a Supabase Edge Function. Set a spending/rate limit on the DeepSeek dashboard as the
# practical mitigation.
EXPO_PUBLIC_DEEPSEEK_API_KEY=your-deepseek-key
